{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Changed"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "style",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Housekeeping",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Housekeeping",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Housekeeping",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Housekeeping",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "apps/site/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/site/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/site/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "skills/diorama-worlds/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-worlds/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-worlds/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "skills/diorama-pixel/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-pixel/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-pixel/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "json",
          "path": "skills/diorama-wash/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-wash/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "skills/diorama-wash/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}
